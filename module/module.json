{
  "manifestVersion": 1,
  "id": "kidsstar",
  "name": "KidsStar",
  "version": "1.0.0",
  "description": "Kinder sammeln mit Alltagsaufgaben Sterne und lösen sie im Sterneshop ein. Braucht den KidsStar-Dienst (Sidecar) auf derselben Adresse.",
  "entry": "index.js",
  "style": "style.css",
  "settings": {
    "entry": "settings.js",
    "sections": ["household"],
    "labelKey": "settings.title"
  },
  "icon": "star",
  "accent": "#F59E0B",
  "i18n": { "defaultLocale": "de" },
  "menu": {
    "show": true,
    "label": "Kinder & Sterne",
    "labelKey": "menu",
    "icon": "star",
    "order": 40
  },
  "page": {
    "composition": "reading",
    "width": "content",
    "navigation": "standard",
    "responsive": "standard"
  },
  "capabilities": {
    "permissions": {
      "module": { "label": "KidsStar", "labelKey": "module", "icon": "star" },
      "widgets": [{ "id": "stars", "label": "Sterne", "labelKey": "widgets.stars" }]
    },
    "widgets": [
      {
        "id": "stars",
        "entry": "widget.js",
        "label": "Sterne",
        "labelKey": "widgets.stars",
        "icon": "star",
        "defaultSize": "2x2",
        "defaultVisible": false
      }
    ],
    "api": { "prefix": "/api/extensions/kidsstar" }
  }
}
